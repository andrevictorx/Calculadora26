<resources>
    <string name="app_name">Calc 26</string>

    <!-- Simbolos dos botoes em codigo Unicode, centralizados aqui para nao
         haver texto "hardcoded" no layout (facilita traducao e manutencao) -->
    <string name="btn_soma">&#x002B;</string>          <!-- + -->
    <string name="btn_subtracao">&#x2212;</string>     <!-- - (menos matematico) -->
