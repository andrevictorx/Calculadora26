    <string name="btn_divisao">&#x00F7;</string>       <!-- / -->
    <string name="btn_igual">&#x003D;</string>         <!-- = -->
    <string name="btn_virgula">&#x002C;</string>       <!-- , -->
    <string name="btn_backspace">&#x232B;</string>     <!-- apagar -->
    <string name="btn_sinal">&#x00B1;</string>         <!-- +/- -->
    <string name="btn_ac">AC</string>

    <!-- As duas operacoes especiais criadas pelo estudante -->
    <string name="btn_porcento">&#x0025;</string>      <!-- % -->
